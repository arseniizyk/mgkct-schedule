# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Shell scripts and batch
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation and code
*.py text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
